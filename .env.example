# Copie ce fichier en `.env` et remplis-le. Ne le commite jamais (ajoute `.env` au .gitignore).

# Généré avec : mix phx.gen.secret
SECRET_KEY_BASE=

# Hôte public du site. En local avec Docker : 127.0.0.1
PHX_HOST=127.0.0.1
PORT=4000

# true = affiche le bouton « Terminer la manche (dev) ». À laisser à false en production.
DEV_TOOLS=false

DEEZER_APP_ID=
DEEZER_SECRET=
DEEZER_REDIRECT_URI=http://127.0.0.1:4000/auth/deezer/callback

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/auth/spotify/callback
