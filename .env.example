# Tout est optionnel : sans ce fichier, le conteneur démarre seul (base embarquée,
# clé générée, connexion par mot de passe, mode démo). Copie-le en `.env` pour régler
# ce dont tu as besoin. Ne le commite jamais.

# Nom de domaine public. Sans lui, le site répond sur localhost.
# PHX_HOST=blindmix.mon-domaine.fr
# PORT=4000

# Clé de signature des sessions (mix phx.gen.secret). Sans elle, une clé est générée
# au premier démarrage et conservée dans le volume /data.
# SECRET_KEY_BASE=

# Base PostgreSQL externe. Sans elle, le conteneur utilise sa base embarquée (/data/postgres).
# DATABASE_URL=ecto://USER:PASS@HOST/blind_mix
# TLS vers la base : automatique si l'URL contient ?sslmode=require (Neon, Supabase).
# DATABASE_SSL=true

# E-mails de connexion (liens magiques). Sans MAIL_PROVIDER, connexion par mot de passe.
# Valeurs : resend, brevo, postmark (avec MAIL_API_KEY) ou smtp (avec SMTP_*).
# MAIL_PROVIDER=
# MAIL_API_KEY=
# MAIL_FROM=noreply@mon-domaine.fr
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# true = affiche les outils de dev (« Terminer la manche »). À laisser à false en production.
DEV_TOOLS=false

# Services musicaux : un service n'est proposé que si ses deux clés sont renseignées.
DEEZER_APP_ID=
DEEZER_SECRET=
DEEZER_REDIRECT_URI=http://localhost:4000/auth/deezer/callback

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/auth/spotify/callback
