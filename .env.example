# Copie ce fichier en `.env` et remplis-le. Ne le commite jamais (ajoute `.env` au .gitignore).

# Généré avec : mix phx.gen.secret
SECRET_KEY_BASE=

# Hôte public du site. En local avec Docker : 127.0.0.1
PHX_HOST=127.0.0.1
PORT=4000

# Base PostgreSQL. Avec docker compose, elle est fournie par le service `db`
# (DATABASE_URL est alors défini dans docker-compose.yml).
# DATABASE_URL=ecto://postgres:postgres@localhost/blind_mix_prod

# E-mails de connexion (liens magiques).
# Sans MAIL_PROVIDER, les liens sont seulement écrits dans les logs du serveur.
# Valeurs possibles : resend, brevo, postmark
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=noreply@ton-domaine.fr

# true = affiche le bouton « Terminer la manche (dev) ». À laisser à false en production.
DEV_TOOLS=false

DEEZER_APP_ID=
DEEZER_SECRET=
DEEZER_REDIRECT_URI=http://127.0.0.1:4000/auth/deezer/callback

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/auth/spotify/callback
