<Layouts.app flash={@flash} current_scope={@current_scope}>
  <h1 class="bm-title bm-title--xl">Blind test multi-pistes</h1>

  <p class="bm-lead bm-center">
    5 {if @spotify? or @deezer?, do: "de tes titres likés", else: "titres du moment"} jouent en même temps.
    Reconnais-les, tape l'artiste ou le titre, et fais disparaître les pistes une à une !
  </p>

  <%= if @current_scope && @current_scope.user do %>
    <p class="bm-note" id="home-profile-note">
      <.icon name="hero-sparkles-mini" class="size-5 shrink-0" />
      <span>
        Tes manches sont enregistrées : plus tu joues, plus elles ciblent tes goûts.
        <.link navigate={~p"/profile"} class="bm-link">Voir mon profil</.link>
      </span>
    </p>
  <% else %>
    <p class="bm-note" id="home-guest-note">
      <.icon name="hero-user-plus-mini" class="size-5 shrink-0" />
      <span>
        <.link navigate={~p"/users/register"} class="bm-link">Crée ton profil</.link>
        pour garder ton historique : les manches s'adapteront à tes goûts.
      </span>
    </p>
  <% end %>

  <div :if={@provider} class="bm-card" id="home-resume">
    <p class="bm-lead">Ta partie est prête, ton service musical est déjà connecté.</p>
    <div class="bm-row">
      <.link navigate={~p"/play"} class="bm-btn" id="home-resume-btn">▶ Reprendre la partie</.link>
      <.link href={~p"/auth/logout"} method="delete" class="bm-btn bm-btn--ghost" id="home-switch">
        Changer de service
      </.link>
    </div>
  </div>

  <%= cond do %>
    <% @provider -> %>
    <% @spotify? or @deezer? -> %>
      <div class="bm-row" id="home-providers">
        <a
          :if={@spotify?}
          href={~p"/auth/spotify"}
          class="bm-btn bm-btn--spotify"
          id="home-spotify"
        >
          Se connecter avec Spotify
        </a>
        <a :if={@deezer?} href={~p"/auth/deezer"} class="bm-btn bm-btn--deezer" id="home-deezer">
          Se connecter avec Deezer
        </a>
      </div>

      <p class="bm-lead bm-center" style="font-size:.95rem">
        Pas de compte {services_label(@spotify?, @deezer?)} ?
        <a href={~p"/auth/demo"} class="bm-link" id="home-demo">Essayer le mode démo</a>
        (titres du classement Deezer)
      </p>
    <% true -> %>
      <div class="bm-row" id="home-providers">
        <a href={~p"/auth/demo"} class="bm-btn" id="home-demo">▶ Jouer</a>
      </div>
      <p class="bm-muted bm-center">Les titres viennent du classement Deezer du moment.</p>
  <% end %>

  <section class="bm-card" id="home-multi">
    <div>
      <h2 class="bm-h2">👥 Jouer à plusieurs</h2>
      <p class="bm-muted">
        Crée une room et envoie le lien : avec ou sans compte, vos morceaux en commun passent
        en priorité. Premier qui trouve, premier qui marque !
      </p>
    </div>
    <div class="bm-home-grid">
      <.form for={%{}} action={~p"/rooms"} id="create-room-form">
        <button class="bm-btn bm-btn--block" id="create-room">Créer une room</button>
      </.form>
      <.form
        for={@join_form}
        action={~p"/rooms/join"}
        method="get"
        id="join-room-form"
        class="bm-join bm-auth"
        style="margin:0"
      >
        <.input
          field={@join_form[:code]}
          type="text"
          placeholder="CODE"
          maxlength="5"
          autocomplete="off"
          aria-label="Code de la room"
          required
        />
        <button class="bm-btn bm-btn--ghost">Rejoindre</button>
      </.form>
    </div>
  </section>
</Layouts.app>
