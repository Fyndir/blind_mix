<BlindMixWeb.Pop.styles />

<div class="bm-wrap">
  <h1 class="bm-title bm-title--xl">Blind test multi-pistes</h1>

  <p class="bm-lead bm-center">
    5 de tes titres likés jouent en même temps. Reconnais-les, tape l'artiste ou le titre,
    et fais disparaître les pistes une à une !
  </p>

  <p :if={Phoenix.Flash.get(@flash, :error)} class="bm-error">
    <%= Phoenix.Flash.get(@flash, :error) %>
  </p>

  <div class="bm-row">
    <a href="/auth/spotify" class="bm-btn bm-btn--spotify">Se connecter avec Spotify</a>
    <a href="/auth/deezer" class="bm-btn bm-btn--deezer">Se connecter avec Deezer</a>
  </div>

  <p class="bm-lead bm-center" style="font-size:.95rem">
    Pas de compte sous la main ?
    <a href="/auth/demo" class="bm-link">Essayer le mode démo</a>
    (titres du classement Deezer)
  </p>
</div>
